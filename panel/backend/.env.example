
# ==============================================================================
# 🔒 Пример конфигурации для SSVproff Panel Backend
# ==============================================================================
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# ⚠️ ВАЖНО: Файл .env НЕ должен попадать в Git!
# ==============================================================================

# ===== Аутентификация =====
# Пароль для доступа к панели (минимум 16 символов)
# Генерация: openssl rand -base64 24
APP_PASSWORD=your_secure_password_here

# Секретный ключ для сессий (64 символа)
# Генерация: openssl rand -hex 32
APP_SECRET=your_secret_key_here_64_characters_long_random_string_123456789

# ===== rclone настройки =====
# Имя удалённого хранилища в rclone (из rclone config)
RCLONE_REMOTE=your_remote_name

# Путь к rclone бинарному файлу (опционально, если не в PATH)
# RCLONE_PATH=/usr/bin/rclone

# ===== PowerShell команды =====
# Директория с разрешёнными PowerShell скриптами (относительно backend/)
ALLOWED_FLOWS_DIR=../../flows

# ===== Логирование =====
# Путь к файлу логов (по умолчанию: ui_actions.log)
# LOG_FILE=ui_actions.log

# Путь к CSV файлу логов (по умолчанию: ui_actions.csv)
# CSV_FILE=ui_actions.csv

# ===== Сервер =====
# Хост (ТОЛЬКО localhost для безопасности!)
# HOST=127.0.0.1

# Порт
# PORT=8000

# ===== Дополнительные настройки =====
# Таймаут для rclone команд (секунды)
# RCLONE_TIMEOUT=300

# Максимальный размер загружаемого файла (MB)
# MAX_UPLOAD_SIZE=100

# ==============================================================================
# 📝 Инструкции:
# 1. Скопируйте этот файл: cp .env.example .env
# 2. Сгенерируйте пароль: openssl rand -base64 24
# 3. Сгенерируйте секрет: openssl rand -hex 32
# 4. Укажите имя rclone remote из: rclone config
# 5. Сохраните файл и запустите панель: python main.py
# ==============================================================================
